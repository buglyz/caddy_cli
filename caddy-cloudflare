#!/usr/bin/env bash
# caddy-cloudflare.sh — Cloudflare DNS-01 版本
# 用法: sudo c cloudflare <token>

DEFAULT_UPDATE_URL="https://raw.githubusercontent.com/buglyz/caddy_cli/main/caddy-cloudflare"

# 定位并加载共享库
LIB_DIR="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
LIB_PATH="${LIB_DIR}/caddy-lib.sh"
if [[ ! -f "$LIB_PATH" ]]; then
    LIB_PATH="$(dirname "$(readlink -f /usr/local/bin/c)")/caddy-lib.sh"
fi
if [[ ! -f "$LIB_PATH" ]]; then
    echo "本地 caddy-lib.sh 未找到，尝试从 GitHub 加载..." >&2
    LIB_CODE="$(curl -fsSL --retry 2 --connect-timeout 10 https://raw.githubusercontent.com/buglyz/caddy_cli/main/caddy-lib.sh)" || {
        echo "Fatal: 无法加载 caddy-lib.sh（本地缺失且 GitHub 不可达）" >&2
        exit 1
    }
    source /dev/stdin <<<"$LIB_CODE"
else
    source "$LIB_PATH"
fi

# ═══════════════════════════════════════
# Cloudflare 专属常量
# ═══════════════════════════════════════
CLOUDFLARE_ENV_FILE="/etc/caddy/cloudflare.env"
CLOUDFLARE_SERVICE_DROPIN="/etc/systemd/system/caddy.service.d/10-cloudflare-env.conf"

# ═══════════════════════════════════════
# Hook 覆盖 — 注入 Cloudflare 行为
# ═══════════════════════════════════════

_hook_ensure_dirs() {
    ensure_cloudflare_service_dropin
}

_hook_fix_permissions() {
    if [[ -f "$CLOUDFLARE_ENV_FILE" ]]; then
        chown root:root "$CLOUDFLARE_ENV_FILE" 2>/dev/null || true
        chmod 600 "$CLOUDFLARE_ENV_FILE" 2>/dev/null || true
    fi
    if [[ -f "$CLOUDFLARE_SERVICE_DROPIN" ]]; then
        chown root:root "$CLOUDFLARE_SERVICE_DROPIN" 2>/dev/null || true
        chmod 644 "$CLOUDFLARE_SERVICE_DROPIN" 2>/dev/null || true
    fi
    # OpenRC: ensure conf.d is readable
    if [[ -f /etc/conf.d/caddy ]]; then
        chown root:root /etc/conf.d/caddy 2>/dev/null || true
        chmod 644 /etc/conf.d/caddy 2>/dev/null || true
    fi
}

_hook_render_global_options() {
    if cloudflare_dns_ready; then
        echo "    dns cloudflare {env.CLOUDFLARE_API_TOKEN}"
    fi
}

_hook_validate_args() {
    if cloudflare_env_configured; then
        printf '%s' "--envfile $CLOUDFLARE_ENV_FILE"
    else
        printf '%s' ''
    fi
}

_hook_menu_config_items() {
    echo "10. Cloudflare DNS 管理"
}

_hook_menu_config_handler() {
    case "$1" in
        10) require_command caddy; with_global_lock run_mutation cloudflare cmd_cloudflare ;;
        *) return 1 ;;
    esac
}

_hook_cli_command() {
    case "$1" in
        cloudflare|cf)
            shift
            require_command caddy
            with_global_lock run_mutation cloudflare cmd_cloudflare "${1:-}"
            ;;
        *) return 1 ;;
    esac
}

_hook_cmd_doctor() {
    if [[ -f "$CLOUDFLARE_ENV_FILE" ]]; then
        echo "[OK] Cloudflare 环境文件存在"
    fi
    if [[ -f "$CLOUDFLARE_SERVICE_DROPIN" ]]; then
        echo "[OK] Cloudflare service drop-in 存在"
    fi
    if [[ -f /etc/conf.d/caddy ]]; then
        echo "[OK] OpenRC conf.d/caddy 存在"
    fi
    if cloudflare_env_configured; then
        echo "[OK] Cloudflare API Token 已配置"
    fi
    if command_exists caddy && caddy list-modules 2>/dev/null | grep -q '^dns.providers.cloudflare$'; then
        echo "[OK] 已内置 Cloudflare DNS 模块"
    else
        echo "[WARN] 未检测到 Cloudflare DNS 模块（需用 install-cloudflare.sh 安装）"
    fi
}

_hook_help_extra() {
    cat <<'EOF'
  c cloudflare <token>      配置 Cloudflare API Token
  c cloudflare check        检查 Cloudflare DNS 就绪状态
  c cloudflare remove       删除 Cloudflare 配置
EOF
}

_hook_list_extra() {
    if cloudflare_env_configured; then
        echo "===== Cloudflare ====="
        echo "状态: 已配置"
        echo
    fi
}

# ═══════════════════════════════════════
# Cloudflare 专属函数
# ═══════════════════════════════════════

validate_cloudflare_token() {
    local token="$1"

    [[ -n "$token" ]] || return 1
    [[ "$token" != *$'\r'* ]] || return 1
    [[ "$token" != *$'\n'* ]] || return 1
    [[ "$token" != *" "* ]] || return 1

    if ! command_exists curl; then
        return 1
    fi

    cloudflare_token_can_use_dns "$token"
}

cloudflare_env_configured() {
    [[ -s "$CLOUDFLARE_ENV_FILE" ]]
}

escape_env_value() {
    local value="$1"
    value="${value//\\/\\\\}"
    value="${value//\"/\\\"}"
    printf '%s' "$value"
}

ensure_cloudflare_service_dropin() {
    if command_exists systemctl; then
        # systemd: EnvironmentFile drop-in
        install -d -m 0755 "$(dirname "$CLOUDFLARE_SERVICE_DROPIN")"
        if [[ ! -f "$CLOUDFLARE_SERVICE_DROPIN" ]]; then
            cat > "$CLOUDFLARE_SERVICE_DROPIN" <<EOF
[Service]
EnvironmentFile=-$CLOUDFLARE_ENV_FILE
EOF
        fi
        chmod 644 "$CLOUDFLARE_SERVICE_DROPIN" 2>/dev/null || true
    elif command_exists rc-service; then
        # OpenRC: source cloudflare.env from conf.d
        if [[ ! -f /etc/conf.d/caddy ]]; then
            cat > /etc/conf.d/caddy <<'DEOF'
# Managed by caddyctl
[ -f /etc/caddy/cloudflare.env ] && . /etc/caddy/cloudflare.env
DEOF
        fi
        chmod 644 /etc/conf.d/caddy 2>/dev/null || true
    fi
}

write_cloudflare_env_file() {
    local token="$1"
    install -d -m 0755 "$(dirname "$CLOUDFLARE_ENV_FILE")"
    cat > "$CLOUDFLARE_ENV_FILE" <<EOF
CLOUDFLARE_API_TOKEN="$(escape_env_value "$token")"
EOF
    chmod 600 "$CLOUDFLARE_ENV_FILE" 2>/dev/null || true
}

remove_cloudflare_env_file() {
    rm -f "$CLOUDFLARE_ENV_FILE" 2>/dev/null || true
}

cloudflare_env_token_value() {
    local line raw value
    [[ -f "$CLOUDFLARE_ENV_FILE" ]] || return 1
    while IFS= read -r line || [[ -n "$line" ]]; do
        line="$(trim "$line")"
        [[ -n "$line" ]] || continue
        [[ "$line" == CLOUDFLARE_API_TOKEN=* ]] || continue
        raw="${line#*=}"
        value="$(strip_wrapping_quotes "$raw")"
        printf '%s' "$value"
        return 0
    done < "$CLOUDFLARE_ENV_FILE"
    return 1
}

cloudflare_domain_candidates() {
    local domain="$1"
    local -a parts=()
    local i candidate

    IFS='.' read -ra parts <<< "$domain"
    if (( ${#parts[@]} < 2 )); then
        return 1
    fi

    for (( i=0; i<=${#parts[@]}-2; i++ )); do
        candidate="${parts[@]:i}"
        candidate="${candidate// /.}"
        [[ -n "$candidate" ]] || continue
        printf '%s\n' "$candidate"
    done
}

cloudflare_api_get() {
    local token="$1"
    local url="$2"
    curl -fsS --retry 2 --retry-delay 1 \
        -H "Authorization: Bearer $token" \
        -H "Content-Type: application/json" \
        "$url"
}

cloudflare_token_can_use_dns() {
    local token="$1"
    local verify_response

    verify_response="$(cloudflare_api_get "$token" "https://api.cloudflare.com/client/v4/user/tokens/verify" 2>/dev/null || true)"
    [[ -n "$verify_response" ]] || return 1

    if ! CF_JSON="$verify_response" python3 - <<'PY' >/dev/null 2>&1
import json, os, re
try:
    data = json.loads(os.environ["CF_JSON"])
except Exception:
    raise SystemExit(1)
if not data.get("success"):
    raise SystemExit(1)
text = json.dumps(data, ensure_ascii=False)
if data.get("result", {}).get("status") != "active":
    raise SystemExit(1)
PY
    then
        return 1
    fi

    return 0
}

cloudflare_domain_resolves_via_cloudflare() {
    local domain="$1"
    if ! command_exists dig; then
        return 1
    fi
    if dig +short NS "$domain" 2>/dev/null | tr 'A-Z' 'a-z' | grep -q 'cloudflare.com'; then
        return 0
    fi
    return 1
}

cloudflare_domain_accessible_with_token() {
    local token="$1"
    local domain="$2"
    local candidate resp

    while IFS= read -r candidate || [[ -n "$candidate" ]]; do
        candidate="$(trim "$candidate")"
        [[ -n "$candidate" ]] || continue
        resp="$(curl -fsS --retry 2 --retry-delay 1 \
            -G "https://api.cloudflare.com/client/v4/zones" \
            --data-urlencode "name=$candidate" \
            --data-urlencode "status=active" \
            --data-urlencode "per_page=1" \
            -H "Authorization: Bearer $token" \
            -H "Content-Type: application/json" 2>/dev/null || true)"
        [[ -n "$resp" ]] || continue
        if CF_JSON="$resp" python3 - <<'PY' >/dev/null 2>&1
import json, os
try:
    data = json.loads(os.environ["CF_JSON"])
except Exception:
    raise SystemExit(1)
if data.get("success") and data.get("result"):
    raise SystemExit(0)
raise SystemExit(1)
PY
        then
            return 0
        fi
    done < <(cloudflare_domain_candidates "$domain")

    return 1
}

cloudflare_site_domains() {
    local file header part
    shopt -s nullglob
    local files=("$SITES_DIR"/*.conf)
    for file in "${files[@]}"; do
        [[ -s "$file" ]] || continue
        while IFS= read -r header || [[ -n "$header" ]]; do
            header="$(trim "$header")"
            [[ -n "$header" ]] || continue
            [[ "$header" == *"{"* ]] || continue
            header="${header%%\{}"
            header="$(trim "$header")"
            [[ -n "$header" ]] || continue
            IFS=',' read -ra parts <<< "$header"
            for part in "${parts[@]}"; do
                part="$(trim "$part")"
                [[ -n "$part" ]] || continue
                case "$part" in
                    www.*) part="${part#www.}" ;;
                esac
                printf '%s\n' "$part"
            done
            break
        done < <(sed -n 's/^[[:space:]]*\([^[:space:]].*\)[[:space:]]*{[[:space:]]*$/\1/p' "$file")
    done | awk '!seen[$0]++'
    shopt -u nullglob
}

cloudflare_dns_ready() {
    local token domain

    token="$(cloudflare_env_token_value)" || return 1

    if ! cloudflare_token_can_use_dns "$token"; then
        return 1
    fi

    mapfile -t domains < <(cloudflare_site_domains)
    if (( ${#domains[@]} == 0 )); then
        return 0
    fi

    for domain in "${domains[@]}"; do
        if ! cloudflare_domain_resolves_via_cloudflare "$domain"; then
            return 1
        fi
        if ! cloudflare_domain_accessible_with_token "$token" "$domain"; then
            return 1
        fi
    done

    return 0
}

# ═══════════════════════════════════════
# Cloudflare 子命令
# ═══════════════════════════════════════

cmd_cloudflare() {
    local token="${1:-}"
    local action="set"
    local env_bak="" dropin_bak="" had_env=0 had_dropin=0
    local token_value

    case "$token" in
        ""|status|show|check)
            if [[ -f "$CLOUDFLARE_ENV_FILE" ]]; then
                say "Cloudflare Token: 已设置"
                token_value="$(cloudflare_env_token_value 2>/dev/null || true)"
                if [[ -n "$token_value" ]] && validate_cloudflare_token "$token_value"; then
                    say "Cloudflare Token 权限: 有效"
                else
                    say "Cloudflare Token 权限: 无效或不足"
                fi
            else
                say "Cloudflare Token: 未设置"
            fi
            if cloudflare_dns_ready; then
                say "Cloudflare DNS-01: 已就绪"
            else
                say "Cloudflare DNS-01: 未就绪，当前会自动回退为 HTTP-01"
            fi
            say "环境文件: $CLOUDFLARE_ENV_FILE"
            return 0
            ;;
        clear|disable|off|none|remove)
            action="clear"
            ;;
    esac

    if [[ "$action" == "set" ]]; then
        if ! validate_cloudflare_token "$token"; then
            fail "Cloudflare Token 不合法或无 DNS 编辑权限"
            return 1
        fi
    fi

    ensure_cloudflare_service_dropin
    if [[ -f "$CLOUDFLARE_ENV_FILE" ]]; then
        env_bak="$(mktemp "$BACKUP_DIR/cloudflare-env.XXXXXX")"
        cp -a "$CLOUDFLARE_ENV_FILE" "$env_bak"
        had_env=1
    fi
    if [[ -f "$CLOUDFLARE_SERVICE_DROPIN" ]]; then
        dropin_bak="$(mktemp "$BACKUP_DIR/cloudflare-dropin.XXXXXX")"
        cp -a "$CLOUDFLARE_SERVICE_DROPIN" "$dropin_bak"
        had_dropin=1
    fi

    if [[ "$action" == "set" ]]; then
        write_cloudflare_env_file "$token"
        say "已写入 Cloudflare Token"
    else
        remove_cloudflare_env_file
        say "已清空 Cloudflare Token"
    fi

    if service_ready; then
        svc_daemon_reload
    fi

    if ! apply_config; then
        if (( had_env )); then
            cp -a "$env_bak" "$CLOUDFLARE_ENV_FILE"
        else
            remove_cloudflare_env_file
        fi
        if (( had_dropin )); then
            cp -a "$dropin_bak" "$CLOUDFLARE_SERVICE_DROPIN"
        else
            rm -f "$CLOUDFLARE_SERVICE_DROPIN" 2>/dev/null || true
        fi
        fix_permissions
        if service_ready; then
            svc_daemon_reload
        fi
        cleanup_paths "$env_bak" "$dropin_bak"
        fail "已回滚 Cloudflare 设置"
        return 1
    fi

    if service_ready; then
        svc_restart
    fi

    cleanup_paths "$env_bak" "$dropin_bak"
    say "Cloudflare DNS-01 已更新"
}

main "$@"
