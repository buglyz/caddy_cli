#!/usr/bin/env bash
# emby-gateway — 通用反代网关（Caddy 版本）
# 从 emby-proxy-toolbox nginx 配置转换而来
# 用法: emby-gateway --domain <域名> [--no-ssl]
set -euo pipefail

DOMAIN=""
NO_SSL=0
ALLOW_SPEC=""
ALLOW_REGEX=""
UNSAFE_OPEN_PROXY=0
CADDY_SITES_DIR="${CADDY_SITES_DIR:-/etc/caddy/sites.d}"
CADDYFILE="${CADDYFILE:-/etc/caddy/Caddyfile}"
CONF_FILE=""
CONF_BACKUP=""

usage() {
    cat <<'EOF'
用法: emby-gateway --domain <域名> --allow <host:port[,host:port...]> [--no-ssl]
      emby-gateway --domain <域名> --unsafe-open-proxy [--no-ssl]

  通用反向代理网关 — 在 Caddy 上部署，通过 URL 路径动态反代任意上游。

  --domain <域名>   网关域名（如 gate.example.com）
  --allow <列表>    允许的上游 host:port，多个用逗号分隔
  --unsafe-open-proxy
                   允许任意上游（高风险，仅限已有认证或内网隔离场景）
  --no-ssl          禁用 HTTPS（仅 HTTP 模式）

示例:
  emby-gateway --domain gate.example.com --allow emby.example.com:443,10.0.0.5:8096
  emby-gateway --domain gate.local --allow 10.0.0.5:8096 --no-ssl

使用方式（部署后）:
  https://gate.example.com/192.168.1.100:8096/   → 反代到 HTTPS 上游
  https://gate.example.com/http/10.0.0.5:8080/   → 反代到 HTTP 上游
  https://gate.example.com/https/1.2.3.4:443/    → 显式 HTTPS 上游
EOF
    exit 0
}

trim_value() {
    local value="$*"
    value="${value#"${value%%[![:space:]]*}"}"
    value="${value%"${value##*[![:space:]]}"}"
    printf '%s' "$value"
}

validate_gateway_upstream() {
    local upstream="$1"
    local host port
    [[ -n "$upstream" ]] || return 1
    [[ "$upstream" != *$'\r'* ]] || return 1
    [[ "$upstream" != *$'\n'* ]] || return 1
    [[ "$upstream" =~ ^[A-Za-z0-9._:-]+$ ]] || return 1
    [[ "$upstream" == *:* ]] || return 1
    host="${upstream%:*}"
    port="${upstream##*:}"
    [[ -n "$host" ]] || return 1
    [[ "$port" =~ ^[0-9]+$ ]] || return 1
    (( 1 <= 10#$port && 10#$port <= 65535 ))
}

validate_gateway_domain() {
    local domain="$1"
    [[ "$domain" =~ ^[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?$ ]] || return 1
    [[ "$domain" == *.* ]] || return 1
}

regex_escape() {
    printf '%s' "$1" | sed 's/[][(){}.^$+*?|\\]/\\&/g'
}

gateway_allow_regex() {
    local spec="$1"
    local item escaped out=""
    local -a items=()

    IFS=',' read -ra items <<< "$spec"
    for item in "${items[@]}"; do
        item="$(trim_value "$item")"
        [[ -n "$item" ]] || continue
        if ! validate_gateway_upstream "$item"; then
            echo "allow-list 条目不合法: $item（请使用 host:port）" >&2
            return 1
        fi
        escaped="$(regex_escape "$item")"
        out="${out:+$out|}$escaped"
    done

    [[ -n "$out" ]] || return 1
    printf '%s' "$out"
}

# ── 参数解析 ──
while [[ $# -gt 0 ]]; do
    case "$1" in
        --domain)
            [[ $# -ge 2 ]] || { echo "--domain 需要参数"; usage; }
            DOMAIN="$2"
            shift 2
            ;;
        --allow)
            [[ $# -ge 2 ]] || { echo "--allow 需要参数"; usage; }
            ALLOW_SPEC="$2"
            shift 2
            ;;
        --unsafe-open-proxy) UNSAFE_OPEN_PROXY=1; shift ;;
        --no-ssl) NO_SSL=1; shift ;;
        -h|--help) usage ;;
        *) echo "未知参数: $1"; usage ;;
    esac
done

if [[ -z "$DOMAIN" ]]; then
    read -rp "请输入网关域名: " DOMAIN
fi
DOMAIN="$(trim_value "$DOMAIN")"
validate_gateway_domain "$DOMAIN" || { echo "域名不合法"; exit 1; }

if [[ -n "$ALLOW_SPEC" && "$UNSAFE_OPEN_PROXY" -eq 1 ]]; then
    echo "--allow 与 --unsafe-open-proxy 不能同时使用" >&2
    exit 1
fi
if [[ -z "$ALLOW_SPEC" && "$UNSAFE_OPEN_PROXY" -ne 1 ]]; then
    echo "默认需要 --allow <host:port,...>，避免创建公网开放代理。" >&2
    echo "确需开放任意上游时使用 --unsafe-open-proxy。" >&2
    exit 1
fi
if [[ -n "$ALLOW_SPEC" ]]; then
    ALLOW_REGEX="$(gateway_allow_regex "$ALLOW_SPEC")" || exit 1
fi

SAFE_DOMAIN="$(printf '%s' "$DOMAIN" | tr '/: ,' '____' | tr -cd 'A-Za-z0-9._-')"
[[ -n "$SAFE_DOMAIN" ]] || { echo "域名不合法"; exit 1; }
CONF_FILE="$CADDY_SITES_DIR/${SAFE_DOMAIN}.conf"
mkdir -p "$CADDY_SITES_DIR"

rollback_conf() {
    if [[ -n "${CONF_BACKUP:-}" && -f "$CONF_BACKUP" ]]; then
        mv "$CONF_BACKUP" "$CONF_FILE"
    else
        rm -f "$CONF_FILE"
    fi
}

cleanup_backup() {
    if [[ -n "${CONF_BACKUP:-}" ]]; then
        rm -f "$CONF_BACKUP"
    fi
}

if [[ -f "$CONF_FILE" ]]; then
    read -rp "站点 $DOMAIN 已存在，覆盖？[y/N]: " CONFIRM
    [[ "${CONFIRM,,}" == "y" ]] || exit 0
    CONF_BACKUP="$(mktemp)"
    cp -a "$CONF_FILE" "$CONF_BACKUP"
fi

echo "正在生成 Caddy 配置: $CONF_FILE"

# ── 公共路由块（HTTP/HTTPS 模式复用） ──
ACCESS_NOTE="任意上游（高风险，仅限受控网络或已加外部认证）"
ALLOWED_ITEMS=()
if [[ -n "$ALLOW_REGEX" ]]; then
    ACCESS_NOTE="仅允许: ${ALLOW_SPEC}"
    IFS=',' read -ra ALLOWED_ITEMS <<< "$ALLOW_SPEC"
fi

gateway_emit_redirect() {
    local matcher="$1"
    local regexp_name="$2"
    local pattern="$3"
    local target="$4"

    cat <<BLOCK
    @$matcher path_regexp $regexp_name $pattern
    redir @$matcher $target 308

BLOCK
}

gateway_emit_proxy_handle() {
    local scheme="$1"
    local matcher="$2"
    local rest_placeholder="$3"
    local upstream="$4"
    local upstream_scheme="$5"
    local host_header="$6"
    local location_prefix="$7"

    cat <<BLOCK
    handle @$matcher {
        rewrite * $rest_placeholder
        reverse_proxy {
            to $upstream
BLOCK
    if [[ "$upstream_scheme" == "http" ]]; then
        cat <<'BLOCK'
            transport http
BLOCK
    else
        cat <<'BLOCK'
            transport http {
                tls
            }
BLOCK
    fi
    cat <<BLOCK
            header_up Host $host_header
            header_up X-Real-IP {remote_host}
            header_down Location ^http://([^/]+)(/.*)\$ ${scheme}://${DOMAIN}/http/\$1\$2
            header_down Location ^https://([^/]+)(/.*)\$ ${scheme}://${DOMAIN}/https/\$1\$2
            header_down Location ^/(.*)\$ ${location_prefix}/\$1
            header_down Location ^([^/:][^:]*)\$ ${location_prefix}/\$1
            flush_interval -1
        }
    }

BLOCK
}

gateway_emit_proxy_route() {
    local scheme="$1"
    local matcher="$2"
    local regexp_name="$3"
    local pattern="$4"
    local rest_placeholder="$5"
    local upstream="$6"
    local upstream_scheme="$7"
    local host_header="$8"
    local location_prefix="$9"

    cat <<BLOCK
    @$matcher path_regexp $regexp_name $pattern
BLOCK
    gateway_emit_proxy_handle "$scheme" "$matcher" "$rest_placeholder" "$upstream" "$upstream_scheme" "$host_header" "$location_prefix"
}

gateway_emit_unsafe_routes() {
    local scheme="$1"

    cat <<BLOCK
    @noSlashHttp path_regexp redir_http ^/http/([A-Za-z0-9.\\-_:]+)\$
    redir @noSlashHttp /http/{re.redir_http.1}/ 308

    @noSlashHttps path_regexp redir_https ^/https/([A-Za-z0-9.\\-_:]+)\$
    redir @noSlashHttps /https/{re.redir_https.1}/ 308

BLOCK
    gateway_emit_proxy_route "$scheme" "httpProxyWithPort" "up_http_port" "^/http/([A-Za-z0-9.\\-_]+):([0-9]+)(/.*)" "{re.up_http_port.3}" "{re.up_http_port.1}:{re.up_http_port.2}" "http" "{re.up_http_port.1}" "${scheme}://${DOMAIN}/http/{re.up_http_port.1}:{re.up_http_port.2}"
    gateway_emit_proxy_route "$scheme" "httpProxyNoPort" "up_http_host" "^/http/([A-Za-z0-9.\\-_]+)(/.*)" "{re.up_http_host.2}" "{re.up_http_host.1}:80" "http" "{re.up_http_host.1}" "${scheme}://${DOMAIN}/http/{re.up_http_host.1}"
    gateway_emit_proxy_route "$scheme" "httpsProxyWithPort" "up_https_port" "^/https/([A-Za-z0-9.\\-_]+):([0-9]+)(/.*)" "{re.up_https_port.3}" "{re.up_https_port.1}:{re.up_https_port.2}" "https" "{re.up_https_port.1}" "${scheme}://${DOMAIN}/https/{re.up_https_port.1}:{re.up_https_port.2}"
    gateway_emit_proxy_route "$scheme" "httpsProxyNoPort" "up_https_host" "^/https/([A-Za-z0-9.\\-_]+)(/.*)" "{re.up_https_host.2}" "{re.up_https_host.1}:443" "https" "{re.up_https_host.1}" "${scheme}://${DOMAIN}/https/{re.up_https_host.1}"
    cat <<'BLOCK'
    @defaultProxyWithPort {
        path_regexp up_default_port ^/([A-Za-z0-9.\-_]+):([0-9]+)(/.*)
        not path /http/* /https/*
    }
BLOCK
    gateway_emit_proxy_handle "$scheme" "defaultProxyWithPort" "{re.up_default_port.3}" "{re.up_default_port.1}:{re.up_default_port.2}" "https" "{re.up_default_port.1}" "${scheme}://${DOMAIN}/{re.up_default_port.1}:{re.up_default_port.2}"
    cat <<'BLOCK'
    @defaultProxyNoPort {
        path_regexp up_default_host ^/([A-Za-z0-9.\-_]+)(/.*)
        not path /http/* /https/*
    }
BLOCK
    gateway_emit_proxy_handle "$scheme" "defaultProxyNoPort" "{re.up_default_host.2}" "{re.up_default_host.1}:443" "https" "{re.up_default_host.1}" "${scheme}://${DOMAIN}/{re.up_default_host.1}"
    cat <<BLOCK
    @noSlash path_regexp redir_bare ^/([A-Za-z0-9.\\-_:]+)\$
    redir @noSlash /{re.redir_bare.1}/ 308
BLOCK
}

gateway_emit_allowed_routes() {
    local scheme="$1"
    local item target target_re host port host_re idx=0

    for item in "${ALLOWED_ITEMS[@]}"; do
        target="$(trim_value "$item")"
        [[ -n "$target" ]] || continue
        host="${target%:*}"
        port="${target##*:}"
        target_re="$(regex_escape "$target")"
        host_re="$(regex_escape "$host")"

        gateway_emit_redirect "noSlashHttp${idx}" "redir_http_${idx}" "^/http/${target_re}\$" "/http/${target}/"
        gateway_emit_redirect "noSlashHttps${idx}" "redir_https_${idx}" "^/https/${target_re}\$" "/https/${target}/"
        gateway_emit_redirect "noSlashDefault${idx}" "redir_default_${idx}" "^/${target_re}\$" "/${target}/"

        gateway_emit_proxy_route "$scheme" "httpProxy${idx}" "up_http_${idx}" "^/http/${target_re}(/.*)" "{re.up_http_${idx}.1}" "$target" "http" "$host" "${scheme}://${DOMAIN}/http/${target}"
        gateway_emit_proxy_route "$scheme" "httpsProxy${idx}" "up_https_${idx}" "^/https/${target_re}(/.*)" "{re.up_https_${idx}.1}" "$target" "https" "$host" "${scheme}://${DOMAIN}/https/${target}"
        gateway_emit_proxy_route "$scheme" "defaultProxy${idx}" "up_default_${idx}" "^/${target_re}(/.*)" "{re.up_default_${idx}.1}" "$target" "https" "$host" "${scheme}://${DOMAIN}/${target}"

        if [[ "$port" == "80" ]]; then
            gateway_emit_redirect "noSlashHttpDefaultPort${idx}" "redir_http_default_port_${idx}" "^/http/${host_re}\$" "/http/${host}/"
            gateway_emit_proxy_route "$scheme" "httpProxyDefaultPort${idx}" "up_http_default_port_${idx}" "^/http/${host_re}(/.*)" "{re.up_http_default_port_${idx}.1}" "${host}:80" "http" "$host" "${scheme}://${DOMAIN}/http/${host}"
        fi

        if [[ "$port" == "443" ]]; then
            gateway_emit_redirect "noSlashHttpsDefaultPort${idx}" "redir_https_default_port_${idx}" "^/https/${host_re}\$" "/https/${host}/"
            gateway_emit_redirect "noSlashDefaultPort${idx}" "redir_default_port_${idx}" "^/${host_re}\$" "/${host}/"
            gateway_emit_proxy_route "$scheme" "httpsProxyDefaultPort${idx}" "up_https_default_port_${idx}" "^/https/${host_re}(/.*)" "{re.up_https_default_port_${idx}.1}" "${host}:443" "https" "$host" "${scheme}://${DOMAIN}/https/${host}"
            gateway_emit_proxy_route "$scheme" "defaultProxyDefaultPort${idx}" "up_default_default_port_${idx}" "^/${host_re}(/.*)" "{re.up_default_default_port_${idx}.1}" "${host}:443" "https" "$host" "${scheme}://${DOMAIN}/${host}"
        fi

        idx=$((idx + 1))
    done

    cat <<'BLOCK'
    handle {
        respond "upstream is not allowed" 403
    }
BLOCK
}

render_routes() {
    local scheme="$1"

    cat <<BLOCK
    request_body {
        max_size 500MB
    }

    handle / {
        respond <<INFO
OK

通用反代网关 — Emby Proxy Toolbox (Caddy)

使用方式：
  ${scheme}://${DOMAIN}/<上游主机:端口>/路径          （默认 HTTPS 回源）
  ${scheme}://${DOMAIN}/http/<上游主机:端口>/路径    （强制 HTTP 回源）

上游限制: ${ACCESS_NOTE}
INFO 200
    }

BLOCK
    if [[ -n "$ALLOW_REGEX" ]]; then
        gateway_emit_allowed_routes "$scheme"
    else
        gateway_emit_unsafe_routes "$scheme"
    fi
}

if [[ "$NO_SSL" -eq 1 ]]; then
    cat > "$CONF_FILE" <<CADDY
# Emby 通用反代网关 (HTTP)
# 域名: ${DOMAIN}
# 生成: $(date '+%F %T')

http://${DOMAIN} {
$(render_routes http)
}
CADDY

else
    cat > "$CONF_FILE" <<CADDY
# Emby 通用反代网关 (HTTPS)
# 域名: ${DOMAIN}
# 生成: $(date '+%F %T')

${DOMAIN} {
$(render_routes https)
}
CADDY

fi

echo "配置已写入: $CONF_FILE"

# ── 校验并重载 ──
if [[ "$CADDY_SITES_DIR" != "/etc/caddy/sites.d" ]]; then
    echo "检测到自定义 CADDY_SITES_DIR，跳过系统校验与重载。"
    cleanup_backup
elif command -v c &>/dev/null; then
    echo "通过 caddy-cli 校验并应用配置..."
    if c apply; then
        echo "已通过 caddy-cli 重载"
        cleanup_backup
    else
        echo "caddy-cli 应用失败，已回滚: $CONF_FILE" >&2
        rollback_conf
        exit 1
    fi
elif command -v caddy &>/dev/null; then
    echo "未检测到 caddy-cli，校验并重载当前 Caddyfile: $CADDYFILE"
    echo "请确认 $CADDYFILE 已导入 $CADDY_SITES_DIR/*.conf，否则新网关不会被加载。"
    echo "校验 Caddy 配置..."
    if caddy validate --config "$CADDYFILE" --adapter caddyfile 2>&1 | tail -1 | grep -q 'Valid'; then
        echo "配置校验通过，重载 Caddy..."
        systemctl reload caddy 2>/dev/null || caddy reload --config "$CADDYFILE" --adapter caddyfile
        echo "已重载 Caddy"
        cleanup_backup
    else
        rollback_conf
        echo "⚠ 配置校验失败，请检查: $CONF_FILE"
        caddy validate --config "$CADDYFILE" --adapter caddyfile 2>&1
        exit 1
    fi
else
    echo "⚠ 未检测到 caddy，配置已生成但未重载"
    echo "   安装 Caddy 后执行: systemctl reload caddy"
    cleanup_backup
fi

echo
echo "======================================"
echo "  部署完成"
echo "  域名: ${DOMAIN}"
echo "  SSL: $([ "$NO_SSL" -eq 1 ] && echo '关闭' || echo '开启（Lets Encrypt 自动签发）')"
echo "  上游: $ACCESS_NOTE"
echo "======================================"
echo
if [[ "$NO_SSL" -eq 1 ]]; then
    echo "使用方式:"
    echo "  http://${DOMAIN}/<上游IP:端口>"
    echo "  http://${DOMAIN}/http/<上游IP:端口>"
else
    echo "使用方式:"
    echo "  https://${DOMAIN}/<上游IP:端口>"
    echo "  https://${DOMAIN}/http/<上游IP:端口>"
fi
